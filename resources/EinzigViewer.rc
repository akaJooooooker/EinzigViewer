#include <windows.h>

101 ICON "icon\\EinzigViewer.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION 0,6,0,0
 PRODUCTVERSION 0,6,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EinzigViewer Project\0"
            VALUE "FileDescription", "EinzigViewer with JPEG XR export and RTX Video Enhancement\0"
            VALUE "FileVersion", "0.6.0\0"
            VALUE "InternalName", "EinzigViewer\0"
            VALUE "OriginalFilename", "EinzigViewer.exe\0"
            VALUE "ProductName", "EinzigViewer\0"
            VALUE "ProductVersion", "0.6.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
