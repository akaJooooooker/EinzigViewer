#include <windows.h>
#include "AppVersion.h"

101 ICON "icon\\EinzigViewer.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
 FILEVERSION EINZIGVIEWER_VERSION_RESOURCE
 PRODUCTVERSION EINZIGVIEWER_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "EinzigViewer Project\0"
            VALUE "FileDescription", "EinzigViewer EPUB and RTX Image Viewer\0"
            VALUE "FileVersion", EINZIGVIEWER_VERSION "\0"
            VALUE "InternalName", "EinzigViewer\0"
            VALUE "OriginalFilename", "EinzigViewer.exe\0"
            VALUE "ProductName", "EinzigViewer\0"
            VALUE "ProductVersion", EINZIGVIEWER_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
