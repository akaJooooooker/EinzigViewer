#include <windows.h>
#include "AiResourceDialogIds.h"

IDD_AI_RESOURCES DIALOGEX 0, 0, 490, 296
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "AI resource settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT "", IDC_AI_INTRO, 12, 6, 466, 18
    CONTROL "Automatic", IDC_AI_AUTOMATIC, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 12, 27, 210, 12
    CONTROL "Manual limits", IDC_AI_MANUAL, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 245, 27, 233, 12
    LTEXT "", IDC_AI_RAM_LABEL, 12, 46, 350, 11
    EDITTEXT IDC_AI_RAM, 374, 43, 104, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_AI_DISK_LABEL, 12, 63, 350, 11
    EDITTEXT IDC_AI_DISK, 374, 60, 104, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_AI_CPU_LABEL, 12, 80, 350, 11
    EDITTEXT IDC_AI_CPU, 374, 77, 104, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_AI_BATCH_LABEL, 12, 97, 350, 11
    EDITTEXT IDC_AI_BATCH, 374, 94, 104, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_AI_GPU_LABEL, 12, 114, 350, 11
    EDITTEXT IDC_AI_GPU, 374, 111, 104, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_AI_SCOPE, 12, 131, 466, 20
    LTEXT "", IDC_AI_GPU_NOTE, 12, 153, 466, 20
    LTEXT "", IDC_AI_RESOURCES_LABEL, 12, 178, 300, 10
    PUSHBUTTON "Refresh resources", IDC_AI_REFRESH, 342, 175, 136, 18
    LTEXT "", IDC_AI_RESOURCES, 12, 196, 466, 19, SS_NOPREFIX
    LTEXT "", IDC_AI_EFFECTIVE_LABEL, 12, 218, 466, 10
    LTEXT "", IDC_AI_EFFECTIVE, 12, 231, 466, 19, SS_NOPREFIX
    LTEXT "", IDC_AI_ERROR, 12, 253, 466, 20, SS_NOPREFIX
    PUSHBUTTON "Reset to automatic", IDC_AI_RESET, 12, 275, 160, 18
    DEFPUSHBUTTON "Apply", IDOK, 342, 275, 65, 18
    PUSHBUTTON "Cancel", IDCANCEL, 413, 275, 65, 18
END
